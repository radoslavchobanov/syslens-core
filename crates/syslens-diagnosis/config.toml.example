# Copy this only to ~/.config/syslens-diagnosis/config.toml and keep it 0600.
# `syslens-diagnosis enable` creates an equivalent owner-only default file.
version = 1
interval_seconds = 30
retention_days = 185
database_budget_bytes = 17179869184

[ai]
# The endpoint client is opt-in. It never installs or starts a local model.
enabled = false
# endpoint_url = "https://ai.example.net/v1/chat/completions"
# Plaintext HTTP is disabled by default. Set this only for a trusted LAN/loopback IP endpoint.
allow_insecure_http = false
# model = "your-compatible-model"
# api_key_env = "SYSLENS_DIAGNOSIS_AI_API_KEY"
request_timeout_seconds = 20

# The host evidence API is a separate, disabled-by-default mTLS service for a
# future SysLens Gateway. It never enables the recorder or AI chat itself.
[api]
enabled = false
bind_address = "127.0.0.1"
port = 9843
# tls_cert_path = "/home/you/.config/syslens-diagnosis/certs/host.crt"
# tls_key_path = "/home/you/.config/syslens-diagnosis/certs/host.key"
# trusted_gateway_ca_path = "/home/you/.config/syslens-diagnosis/certs/gateway-ca.crt"
max_request_bytes = 16384
max_response_bytes = 262144
max_query_millis = 2000
# Accepted sockets must finish TLS before this deadline, and the cap includes
# both handshakes and active HTTP requests. Excess sockets are closed.
tls_handshake_timeout_millis = 5000
max_in_flight_connections = 32
# HTTP/1 has no keep-alive here. This deadline includes headers and body, so a
# slow or incomplete request cannot retain an in-flight slot indefinitely.
http_request_timeout_millis = 10000
