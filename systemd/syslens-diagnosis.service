[Unit]
Description=SysLens local diagnosis companion

[Service]
Type=simple
ExecStart=%h/.local/bin/syslens-diagnosis daemon --config %h/.config/syslens-diagnosis/config.toml --database %h/.local/state/syslens-diagnosis/diagnosis.sqlite
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
